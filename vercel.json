{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://career-api-4nux.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://career-api-4nux.onrender.com/api/:path*"
    },
    {
      "source": "/((?!auth|api).*)",
      "destination": "/index.html"
    }
  ]
}